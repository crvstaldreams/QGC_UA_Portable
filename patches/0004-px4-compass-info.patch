+                                wrapMode:   Text.WordWrap
+                            }
+
+                            QGCLabel {
+                                width:      parent.width
+                                text:       qsTr("Orientation: %1").arg(compassOrientationText(index))
+                                wrapMode:   Text.WordWrap
