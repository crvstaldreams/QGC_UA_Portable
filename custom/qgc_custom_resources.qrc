<RCC>
    <qresource prefix="/fonts">
        <file alias="play-regular">resources/Play-Regular.ttf</file>
        <file alias="play-bold">resources/Play-Bold.ttf</file>
    </qresource>
    <qresource prefix="/qml/QGroundControl/Custom">
        <file alias="ServiceMode.qml">qml/ServiceMode.qml</file>
        <file alias="ServiceParameterEditor.qml">qml/ServiceParameterEditor.qml</file>
        <file alias="ServiceServoSafety.qml">qml/ServiceServoSafety.qml</file>
        <file alias="ServiceMavlinkStatus.qml">qml/ServiceMavlinkStatus.qml</file>
        <file alias="ServiceMPParams.qml">qml/ServiceMPParams.qml</file>
    </qresource>
</RCC>
